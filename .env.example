# ── Database ────────────────────────────────────────────────────────────────
# Neon: copy the POOLED connection string from the Neon console (it ends in
# -pooler). Use sslmode=verify-full — it is what `require` does today, and it
# is the only mode pg will keep supporting without a warning.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/DBNAME?sslmode=verify-full"

# ── Login ────────────────────────────────────────────────────────────────────
# Single-user sign-in for the board (pages and APIs are both protected).
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me"
# Signs the session cookie — 7-day sessions. Generate with: openssl rand -base64 32
# Rotating it signs everyone out.
SESSION_SECRET=""

# ── Groq ────────────────────────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
# Leave empty to fall back to the built-in local parser (app still works).
GROQ_API_KEY=""

# Current production models. NOTE: llama-3.3-70b-versatile and
# llama-3.1-8b-instant are Enterprise-gated and return 404 on standard keys —
# list what your key can call: GET https://api.groq.com/openai/v1/models
# openai/gpt-oss-120b (best extraction), openai/gpt-oss-20b (fastest),
# qwen/qwen3.8-27b
GROQ_MODEL="openai/gpt-oss-120b"
